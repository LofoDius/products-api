# Copy to .env and change the password before first start.
MONGO_ROOT_USERNAME=products
MONGO_ROOT_PASSWORD=changeme
API_PORT=18080

# App update hosting (GET /app/latest, GET /app/download, POST /app/releases).
# Shared secret sent as the X-Deploy-Token header when uploading an APK.
# Empty value rejects every upload. Generate e.g. with: openssl rand -hex 32
APP_RELEASES_DEPLOY_TOKEN=change-me-deploy-token
